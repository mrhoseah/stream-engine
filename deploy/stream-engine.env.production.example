# Stream Engine production environment template
# Copy to: /etc/stream-engine/stream-engine.env
# Ensure permissions: chown root:stream-engine && chmod 640

# Core
STREAM_ENGINE_PORT=8080

# TLS/mTLS (server)
STREAM_ENGINE_TLS_ENABLED=true
STREAM_ENGINE_TLS_KEY_STORE=/etc/stream-engine/tls/server-keystore.p12
STREAM_ENGINE_TLS_KEY_STORE_PASSWORD=CHANGE_ME
STREAM_ENGINE_TLS_KEY_STORE_TYPE=PKCS12
STREAM_ENGINE_TLS_KEY_ALIAS=stream-engine
STREAM_ENGINE_TLS_CLIENT_AUTH=need
STREAM_ENGINE_TLS_TRUST_STORE=/etc/stream-engine/tls/stream-engine-client-truststore.p12
STREAM_ENGINE_TLS_TRUST_STORE_PASSWORD=CHANGE_ME
STREAM_ENGINE_TLS_TRUST_STORE_TYPE=PKCS12

# Red5 outbound integration
RED5_MODE=http
RED5_STUB_ENABLED=false
RED5_ENFORCE_HTTPS=true
RED5_BASE_URL=https://red5.internal
RED5_START_PATH=/stream-engine/start
RED5_STOP_PATH=/stream-engine/stop
RED5_SECRET_HEADER=X-Stream-Engine-Secret
RED5_SHARED_SECRET=CHANGE_ME
RED5_CONNECT_TIMEOUT_MS=5000
RED5_READ_TIMEOUT_MS=5000

# Recastly outbound integration
RECASTLY_ENABLED=true
RECASTLY_ENFORCE_HTTPS=true
RECASTLY_BASE_URL=https://recastly.internal
RECASTLY_SECRET_HEADER=X-Stream-Engine-Secret
RECASTLY_SHARED_SECRET=CHANGE_ME
RECASTLY_VALIDATE_PATH=/stream-engine/validate-key
RECASTLY_WEBHOOK_PATH=/stream-engine/webhook
RECASTLY_CONNECT_TIMEOUT_MS=5000
RECASTLY_READ_TIMEOUT_MS=5000

# Inbound security (Recastly -> Stream Engine write APIs)
RECASTLY_INBOUND_AUTH_REQUIRED=true
RECASTLY_INBOUND_SIGNATURE_REQUIRED=true
RECASTLY_INBOUND_TIMESTAMP_HEADER=X-Stream-Engine-Timestamp
RECASTLY_INBOUND_SIGNATURE_HEADER=X-Stream-Engine-Signature
RECASTLY_INBOUND_NONCE_HEADER=X-Stream-Engine-Nonce
RECASTLY_INBOUND_MAX_SKEW_SEC=300
RECASTLY_INBOUND_REPLAY_WINDOW_SEC=600
RECASTLY_INBOUND_RATE_LIMIT_PER_MINUTE=120
RECASTLY_INBOUND_TRUST_FORWARDED_FOR=false

# Optional comma-separated allowlist (leave blank to disable)
RECASTLY_INBOUND_ALLOWED_IPS=
# Optional comma-separated proxy IPs allowed to supply X-Forwarded-For
RECASTLY_INBOUND_TRUSTED_PROXY_IPS=

# Actuator exposure (hardened default). Only add metrics/prometheus on private networks.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
